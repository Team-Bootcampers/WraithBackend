# ─── auth-service (kendi Postgres DB'si: login audit) ───
AUTH_DB_HOST=auth-postgres
AUTH_DB_PORT=5432
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

AUTH_HTTP_PORT=3001
AUTH_HOST=api.localhost

# ─── user-service (kendi Postgres DB'si: kullanıcı profilleri) ───
USER_DB_HOST=user-postgres
USER_DB_PORT=5432
USER_DB_USER=user_service
USER_DB_PASSWORD=change-me
USER_DB_NAME=user_db

USER_GRPC_PORT=5001
USER_SERVICE_GRPC_URL=user-service:5001

# ─── Firebase Auth ───
# Admin SDK (service account) — signup/createUser ve rollback için
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Web API key (Firebase Console > Project Settings > General) — login (Identity Toolkit REST) için
FIREBASE_API_KEY=

NODE_ENV=development

# ─── ai-service (Gemini ile seyahat kişiliği analizi, DB'siz/stateless) ───
AI_GRPC_PORT=5002
AI_SERVICE_GRPC_URL=ai-service:5002
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─── Sonraki fazlarda eklenecek (henüz aktif değil) ───
# NATS (event-driven servisler için)
# NATS_URL=nats://nats:4222

# ─── gateway (Traefik arkasında tüm servisleri toplayacak tek giriş noktası) ───
GATEWAY_HTTP_PORT=3000
GATEWAY_HOST=api.localhost
