# ─── auth-service (kendi Postgres DB'si: login audit) ───
AUTH_DB_HOST=auth-postgres
AUTH_DB_PORT=5432
AUTH_DB_USER=auth_service
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

AUTH_HTTP_PORT=3001
AUTH_HOST=api.localhost

# ─── user-service (kendi Postgres DB'si: kullanıcı profilleri) ───
USER_DB_HOST=user-postgres
USER_DB_PORT=5432
USER_DB_USER=user_service
USER_DB_PASSWORD=change-me
USER_DB_NAME=user_db

USER_GRPC_PORT=5001
USER_SERVICE_GRPC_URL=user-service:5001

# ─── Firebase Auth ───
# Admin SDK (service account) — signup/createUser ve rollback için
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Web API key (Firebase Console > Project Settings > General) — login (Identity Toolkit REST) için
FIREBASE_API_KEY=

NODE_ENV=development

# ─── ai-service (Gemini ile seyahat kişiliği analizi, DB'siz/stateless) ───
AI_GRPC_PORT=5002
AI_SERVICE_GRPC_URL=ai-service:5002
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# ─── hotel-service (kendi Postgres DB'si: JSON'dan seed edilen otel verisi) ───
HOTEL_DB_HOST=hotel-postgres
HOTEL_DB_PORT=5432
HOTEL_DB_USER=hotel_service
HOTEL_DB_PASSWORD=change-me
HOTEL_DB_NAME=hotel_db

HOTEL_GRPC_PORT=5003
HOTEL_SERVICE_GRPC_URL=hotel-service:5003

# ─── restaurant-service (kendi Postgres DB'si: JSON'dan seed edilen restoran verisi) ───
RESTAURANT_DB_HOST=restaurant-postgres
RESTAURANT_DB_PORT=5432
RESTAURANT_DB_USER=restaurant_service
RESTAURANT_DB_PASSWORD=change-me
RESTAURANT_DB_NAME=restaurant_db

RESTAURANT_GRPC_PORT=5004
RESTAURANT_SERVICE_GRPC_URL=restaurant-service:5004

# ─── attraction-service (kendi Postgres DB'si: JSON'dan seed edilen gezilecek yer verisi) ───
ATTRACTION_DB_HOST=attraction-postgres
ATTRACTION_DB_PORT=5432
ATTRACTION_DB_USER=attraction_service
ATTRACTION_DB_PASSWORD=change-me
ATTRACTION_DB_NAME=attraction_db

ATTRACTION_GRPC_PORT=5005
ATTRACTION_SERVICE_GRPC_URL=attraction-service:5005

# ─── Sonraki fazlarda eklenecek (henüz aktif değil) ───
# NATS (event-driven servisler için)
# NATS_URL=nats://nats:4222

# ─── gateway (Traefik arkasında tüm servisleri toplayacak tek giriş noktası) ───
GATEWAY_HTTP_PORT=3000
GATEWAY_HOST=api.localhost
